<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="13dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👜 我的消費簿"
        android:textColor="#2E2926"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_month_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月支出" android:textColor="#86766D" android:textSize="10sp" />
            <TextView android:id="@+id/widget_month_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0" android:textColor="#27221F" android:textSize="20sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_today_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天支出" android:textColor="#86766D" android:textSize="10sp" />
            <TextView android:id="@+id/widget_today_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0" android:textColor="#B36F4F" android:textSize="20sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_pickup_block"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_status_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待取貨" android:textColor="#725F54" android:textSize="9sp" />
            <TextView android:id="@+id/widget_pickup_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#A96749" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_payment_block"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_status_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💳" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待付款" android:textColor="#725F54" android:textSize="9sp" />
            <TextView android:id="@+id/widget_payment_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#A96749" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_shipping_block"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:background="@drawable/widget_status_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚚" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待出貨" android:textColor="#725F54" android:textSize="9sp" />
            <TextView android:id="@+id/widget_shipping_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#A96749" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_reminder_block"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/widget_status_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textSize="15sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="近期提醒" android:textColor="#725F54" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_reminder_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="目前沒有提醒" android:textColor="#4C433E" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#9D8679" android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_accent"
        android:gravity="center"
        android:text="＋ 記一筆"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
